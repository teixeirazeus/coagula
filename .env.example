# Coagula — Environment Variables
#
# At least one API key must be set for your chosen provider.
# Copy this file to .env and fill in the keys.

# OpenAI — required when provider="openai" (default)
OPENAI_API_KEY=sk-your-key-here

# Anthropic — required when provider="anthropic"
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Gemini — required when provider="gemini"
GEMINI_API_KEY=your-gemini-key-here
